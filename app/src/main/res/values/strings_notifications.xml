    <string name="notif_text_with_amount">%1$s · %2$s</string>

    <!-- "When" phrases dropped into the lines below as %2$s -->
    <string name="phrase_tomorrow">tomorrow</string>
    <string name="phrase_now">now</string>
    <string name="phrase_earlier_today">earlier today</string>
    <string name="phrase_yesterday">yesterday</string>
    <string name="phrase_since">on %1$s</string>
    <plurals name="phrase_in_days">
        <item quantity="one">in %d day</item>
        <item quantity="other">in %d days</item>
    </plurals>
    <plurals name="phrase_in_hours">
